{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "paths": {
      "@codex/app-server-protocol/*": [
        "../codex-rs/app-server-protocol/schema/typescript/*",
        "../codex/codex-rs/app-server-protocol/schema/typescript/*"
      ]
    },
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
