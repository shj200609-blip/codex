{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CurrentHunkRangeKind": {
      "description": "How a live range should be revealed in the current file.",
      "oneOf": [
        {
          "enum": [
            "content",
            "deletionAnchor"
          ],
          "type": "string"
        },
        {
          "description": "An empty created file has presence but no content lines.",
          "enum": [
            "filePresence"
          ],
          "type": "string"
        }
      ]
    },
    "HunkLocationResult": {
      "description": "Read-only, point-in-time location; never changes review decisions.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "$ref": "#/definitions/CurrentHunkRangeKind"
            },
            "line_count": {
              "description": "Current after-side lines, excluding matching context. Zero for anchors.",
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "start_line": {
              "description": "One-based current line (consistent with protocol file locations). For an anchor, the insertion point before this line; EOF is N + 1.",
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "status": {
              "enum": [
                "located"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind",
            "line_count",
            "start_line",
            "status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "$ref": "#/definitions/HunkNotPresentReason"
            },
            "status": {
              "enum": [
                "notPresent"
              ],
              "type": "string"
            }
          },
          "required": [
            "reason",
            "status"
          ],
          "type": "object"
        },
        {
          "description": "Exact matching failed, was ambiguous, or the filesystem could not be read.",
          "properties": {
            "reason": {
              "type": "string"
            },
            "status": {
              "enum": [
                "conflict"
              ],
              "type": "string"
            }
          },
          "required": [
            "reason",
            "status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "type": "string"
            },
            "status": {
              "enum": [
                "unsupported"
              ],
              "type": "string"
            }
          },
          "required": [
            "reason",
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "HunkNotPresentReason": {
      "enum": [
        "reverted",
        "fileDeleted",
        "fileMissing"
      ],
      "type": "string"
    }
  },
  "description": "Path uses the same absolute executor path URI as ChangeSetFile.path.",
  "properties": {
    "changeSetId": {
      "type": "string"
    },
    "fileId": {
      "type": "string"
    },
    "hunkId": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "result": {
      "$ref": "#/definitions/HunkLocationResult"
    }
  },
  "required": [
    "changeSetId",
    "fileId",
    "hunkId",
    "path",
    "result"
  ],
  "title": "ChangeSetHunkLocateResponse",
  "type": "object"
}